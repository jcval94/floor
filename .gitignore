__pycache__/
*.pyc
.pytest_cache/
.venv/
*.egg-info/

# Runtime / generated state is stored outside Git history.
# GitHub Release `runtime-state-v1` keeps the rolling operational state;
# GitHub Actions artifacts keep immutable per-run audit outputs.
data/*
!data/.gitkeep
!data/training/
data/training/*
!data/training/models/
data/training/models/*
!data/training/models/*.json

# Local/reconstructable databases and archives.
*.sqlite
*.sqlite-wal
*.sqlite-shm
.runtime/
*.tar.gz

# GitHub Pages JSON is generated and audited at deployment time.
# Keeping snapshots in git creates a second stale source of truth.
site/data/*.json
docs/data/*.json
